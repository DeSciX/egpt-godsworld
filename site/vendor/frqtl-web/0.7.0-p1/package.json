{
  "name": "@descix/frqtl-web",
  "version": "0.7.0-p1",
  "description": "FRQTL for the browser \u2014 the discrete fractal physics engine (compiled Rust \u2192 WASM), its parts as ES modules, the scene doors (bootScene, bootProject) and frqtl-web.min.js.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": "./dist/frqtl/boot-entry.js",
    "./boot": {
      "node": "./dist/boot/node-refusal.js",
      "default": "./dist/frqtl/experiments/_shared/doors.js"
    },
    "./parts": "./dist/frqtl/parts/index.js",
    "./parts/*": "./dist/frqtl/parts/*",
    "./project": "./dist/shim/project/index.js",
    "./registry": "./dist/shim/registry/index.js",
    "./host-view": "./dist/shim/host/index.js",
    "./site-graph": "./dist/shim/engine/site-graph.js",
    "./site-assemble": {
      "node": "./dist/shim/engine/site-assemble.mjs",
      "default": "./dist/site-assemble/browser-refusal.js"
    },
    "./studio": "./dist/studio/app.html",
    "./shim/controls/registry.js": "./dist/shim/controls/registry.js",
    "./shim/render/sun-look.js": "./dist/shim/render/sun-look.js",
    "./compat/renderer/display-slot.js": "./dist/frqtl/compat/renderer/display-slot.js",
    "./compat/renderer/orbit-bag.js": "./dist/frqtl/compat/renderer/orbit-bag.js",
    "./objects/setup/_collisionMatrixLanes.js": "./dist/frqtl/objects/setup/_collisionMatrixLanes.js",
    "./compat/engine.js": "./dist/frqtl/compat/engine.js",
    "./kinds": "./dist/frqtl/objects/kinds-entry.js",
    "./objects/objects/tagger.js": "./dist/frqtl/objects/objects/tagger.js",
    "./objects/schema/index.js": "./dist/frqtl/objects/schema/index.js",
    "./shim/render/heat-colormap.js": "./dist/shim/render/heat-colormap.js",
    "./objects/schema/valueNormalizer.js": "./dist/frqtl/objects/schema/valueNormalizer.js",
    "./objects/objects/Box.js": "./dist/frqtl/objects/objects/Box.js",
    "./objects/objects/QuantumEmitter.js": "./dist/frqtl/objects/objects/QuantumEmitter.js",
    "./shim/expr/ast-schema.js": "./dist/shim/expr/ast-schema.js",
    "./objects/objects/actionCompiler.js": "./dist/frqtl/objects/objects/actionCompiler.js",
    "./objects/v1-replacements.js": "./dist/frqtl/objects/v1-replacements.js",
    "./objects/objects/slitLinerScatter.js": "./dist/frqtl/objects/objects/slitLinerScatter.js",
    "./objects/setup/setupSphereEmitter3D.js": "./dist/frqtl/objects/setup/setupSphereEmitter3D.js",
    "./objects/objects/directedRedirectProgram.js": "./dist/frqtl/objects/objects/directedRedirectProgram.js",
    "./compat/renderer/lo-drawn-center.js": "./dist/frqtl/compat/renderer/lo-drawn-center.js",
    "./objects/setup/setupTunnelPointExit.js": "./dist/frqtl/objects/setup/setupTunnelPointExit.js",
    "./objects/constants/WallBehaviors.js": "./dist/frqtl/objects/constants/WallBehaviors.js",
    "./objects/objects/absorbRadiation.js": "./dist/frqtl/objects/objects/absorbRadiation.js",
    "./objects/geometry/SlabFace.js": "./dist/frqtl/objects/geometry/SlabFace.js",
    "./dist-manifest.json": "./dist/dist-manifest.json",
    "./package.json": "./package.json"
  },
  "exportsNotes": "The exports map is documented in README.md, section Exports.",
  "files": [
    "dist",
    "README.md",
    "llms.txt",
    "CLAUDE.md",
    "LICENSE.md"
  ],
  "scripts": {
    "build": "node build.js",
    "verify:packages": "node ../_build/verify-publish-surface.mjs",
    "verify:build-closure": "node ../_build/verify-build-closure.mjs",
    "verify:parity-core": "node ../_build/verify-parity-core.mjs",
    "pack:dry-run": "npm pack --dry-run --ignore-scripts",
    "prepack": "npm run build && npm run verify:packages && npm run verify:build-closure && npm run verify:parity-core"
  },
  "notes": "npm publish/pack runs from this directory. `files` is npm's native allowlist (dist/ is gitignored, but `files` bypasses .gitignore; src/, build.js and scripts/ stay home). `prepack` rebuilds dist/ and re-verifies BOTH FRQTL packages (sdk/_build/verify-publish-surface.mjs judges @descix/frqtl-web and @descix/frqtl-node together: they are one source built twice), so sdk/frqtl-node must be built first.",
  "keywords": [
    "physics",
    "engine",
    "simulation",
    "fractal",
    "cellular-automata",
    "particle",
    "quantum",
    "wave-particle-duality",
    "emergent",
    "discrete-physics",
    "egpt",
    "frqtl",
    "descix"
  ],
  "author": "Essam Abadir",
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "acorn": "^8.16.0",
    "chart.js": "4.5.1",
    "esbuild": "^0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "5.4.21"
  }
}
